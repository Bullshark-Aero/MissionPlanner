{
  "SchemaVersion": 1,
  "Metadata": {
    "Name": "BSA 75kg VTOL default preflight",
    "ConfigVersion": "1.2.0",
    "Groups": [
      "Identity & Configuration",
      "Telemetry & Sensors",
      "Mission",
      "Walkaround",
      "Control Surfaces",
      "Payload & Arming"
    ]
  },
  "Checks": [
    {
      "Id": "correct-aircraft",
      "Title": "Correct aircraft connected",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Identity & Configuration",
      "Instruction": "Confirm the tail number / airframe ID of the connected vehicle matches the mission and paperwork for this flight. Note the aircraft ID below - it is recorded as this run's aircraft identity.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "telemetry-healthy",
      "Title": "Telemetry link healthy",
      "Type": "Auto",
      "Severity": "Warning",
      "Group": "Telemetry & Sensors",
      "Source": "Telemetry",
      "Field": "linkqualitygcs",
      "Condition": "GTEQ",
      "Value": 80,
      "AllowNotApplicable": false
    },
    {
      "Id": "mpconfig-speech-enabled",
      "Title": "Audible alerts enabled",
      "Type": "Auto",
      "Severity": "Warning",
      "Group": "Identity & Configuration",
      "Source": "MpConfig",
      "Field": "speechenable",
      "Condition": "EQ",
      "Value": "True",
      "AllowNotApplicable": false
    },
    {
      "Id": "mpconfig-units-confirmed",
      "Title": "Display units configured correctly",
      "Type": "Manual",
      "Severity": "Warning",
      "Group": "Identity & Configuration",
      "Instruction": "Confirm distance/altitude/speed units shown in Mission Planner match your operating procedure.",
      "AllowNotApplicable": false
    },
    {
      "Id": "mpconfig-approved-package-match",
      "Title": "MP config matches approved package",
      "Type": "Auto",
      "Severity": "Warning",
      "Group": "Identity & Configuration",
      "Source": "MpConfig",
      "Check": "mpconfig.approvedPackageMatch",
      "AllowNotApplicable": true
    },
    {
      "Id": "mission-nonempty",
      "Title": "Mission is loaded and not empty",
      "Type": "Auto",
      "Severity": "Critical",
      "Group": "Mission",
      "Source": "Mission",
      "Check": "mission.nonempty",
      "AllowNotApplicable": false
    },
    {
      "Id": "mission-takeoff-landing",
      "Title": "Mission has takeoff and landing",
      "Type": "Auto",
      "Severity": "Critical",
      "Group": "Mission",
      "Source": "Mission",
      "Check": "mission.hasTakeoffAndLanding",
      "AllowNotApplicable": false
    },
    {
      "Id": "mission-home-plausible",
      "Title": "Mission home position is plausible",
      "Type": "Auto",
      "Severity": "Warning",
      "Group": "Mission",
      "Source": "Mission",
      "Check": "mission.homePlausible",
      "AllowNotApplicable": true
    },
    {
      "Id": "mission-fence-present",
      "Title": "Geofence loaded",
      "Type": "Auto",
      "Severity": "Info",
      "Group": "Mission",
      "Source": "Mission",
      "Check": "mission.fencePresent",
      "AllowNotApplicable": true
    },
    {
      "Id": "mission-rally-present",
      "Title": "Rally points loaded",
      "Type": "Auto",
      "Severity": "Info",
      "Group": "Mission",
      "Source": "Mission",
      "Check": "mission.rallyPresent",
      "AllowNotApplicable": true
    },
    {
      "Id": "battery-status-visible",
      "Title": "Battery status visible and acceptable",
      "Type": "Semi",
      "Severity": "Warning",
      "Group": "Telemetry & Sensors",
      "Source": "Telemetry",
      "Field": "battery_remaining",
      "Condition": "GTEQ",
      "Value": 50,
      "Instruction": "Confirm the displayed battery percentage/voltage is acceptable for this flight.",
      "AllowNotApplicable": false
    },
    {
      "Id": "gps-ekf-status-visible",
      "Title": "GPS/EKF status visible and healthy",
      "Type": "Semi",
      "Severity": "Warning",
      "Group": "Telemetry & Sensors",
      "Source": "Telemetry",
      "Field": "ekfstatus",
      "Condition": "LT",
      "Value": 1,
      "Instruction": "Confirm GPS fix (3D or better) and EKF status shown are healthy before continuing.",
      "AllowNotApplicable": false
    },
    {
      "Id": "walkaround-nose",
      "Title": "Walkaround: nose section",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Walkaround",
      "Instruction": "Check nose structure, pitot/static area, antennas and fasteners. Record any defect in the notes.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "walkaround-fuselage-tail",
      "Title": "Walkaround: fuselage and tail",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Walkaround",
      "Instruction": "Check fuselage skin, access panels, tail structure and control horns for damage or loose fasteners.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "walkaround-wings-control-surfaces",
      "Title": "Walkaround: wings and control surfaces",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Walkaround",
      "Instruction": "Check wing structure, control surface hinges and linkages for damage, play or obstruction.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "walkaround-landing-gear",
      "Title": "Walkaround: landing gear",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Walkaround",
      "Instruction": "Check landing gear/skids for damage and secure attachment.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "surface-check-aileron",
      "Title": "Commanded surface movement: aileron",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Control Surfaces",
      "Instruction": "Aircraft disarmed. Move the aileron stick left, then right. Confirm each aileron moves the correct direction, moves smoothly and returns to neutral.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "surface-check-elevator",
      "Title": "Commanded surface movement: elevator",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Control Surfaces",
      "Instruction": "Aircraft disarmed. Move the elevator stick up, then down. Confirm the elevator moves the correct direction, moves smoothly and returns to neutral.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "surface-check-rudder",
      "Title": "Commanded surface movement: rudder",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Control Surfaces",
      "Instruction": "Aircraft disarmed. Move the rudder stick left, then right. Confirm the rudder moves the correct direction, moves smoothly and returns to neutral.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "payload-battery-secured",
      "Title": "Payload and battery secured",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Payload & Arming",
      "Instruction": "Confirm payload and flight battery are correctly seated and secured, with no possibility of shifting in flight.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "prop-rotor-area-clear",
      "Title": "Propeller/rotor area clear",
      "Type": "Manual",
      "Severity": "Critical",
      "Group": "Payload & Arming",
      "Instruction": "Confirm propeller/rotor discs are clear of obstructions, tools and people before arming.",
      "RequiresNoteOnFail": true,
      "AllowNotApplicable": false
    },
    {
      "Id": "mission-unchanged-during-preflight",
      "Title": "Mission unchanged during preflight",
      "Type": "Auto",
      "Severity": "Critical",
      "Group": "Mission",
      "Source": "Mission",
      "Check": "mission.unchangedDuringPreflight",
      "AllowNotApplicable": false,
      "DeferredToSignOff": true
    }
  ]
}
